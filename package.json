{
  "name": "blog-server",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "yarn workspace @gaaamii/site dev",
    "dev:editor": "yarn workspace @gaaamii/editor dev",
    "dev:editor-mock-api": "yarn workspace @gaaamii/editor mock:api",
    "build:site": "yarn workspace @gaaamii/site build",
    "build:editor": "yarn workspace @gaaamii/editor build",
    "preview:site": "yarn workspace @gaaamii/site preview",
    "check:site": "yarn workspace @gaaamii/site run check",
    "start:editor": "yarn workspace @gaaamii/editor preview",
    "preview:editor": "yarn workspace @gaaamii/editor preview"
  },
  "dependencies": {
    "@types/luxon": "^3.4.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "luxon": "^3.5.0",
    "react": "19.2.3",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@types/react": "^19.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
