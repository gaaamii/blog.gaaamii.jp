{
  "name": "blog-server",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:site": "yarn workspace @gaaamii/site dev",
    "dev:editor": "yarn workspace @gaaamii/editor dev",
    "dev:editor-mock-api": "yarn workspace @gaaamii/editor mock:api",
    "dev:editor-legacy": "yarn workspace @gaaamii/editor-legacy dev",
    "build:site": "yarn workspace @gaaamii/site build",
    "build:editor": "yarn workspace @gaaamii/editor build",
    "build:editor-legacy": "yarn workspace @gaaamii/editor-legacy build",
    "start:site": "yarn workspace @gaaamii/site start",
    "start:editor": "yarn workspace @gaaamii/editor preview",
    "preview:editor": "yarn workspace @gaaamii/editor preview",
    "start:editor-legacy": "yarn workspace @gaaamii/editor-legacy start"
  },
  "dependencies": {
    "@types/classnames": "^2.3.4",
    "@types/luxon": "^3.4.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@tailwindcss/postcss": "^4.0.15",
    "classnames": "^2.5.1",
    "image-size": "^2.0.2",
    "luxon": "^3.5.0",
    "next": "16.1.2",
    "next-mdx-remote": "^5.0.0",
    "postcss": "^8.5.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.0",
    "rss": "^1.2.2",
    "tailwindcss": "^4.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.7",
    "prettier": "^3.7.4",
    "typescript": "^5.9.3"
  }
}
