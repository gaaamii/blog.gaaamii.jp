{
  "name": "blog-server",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev:site": "pnpm --filter @gaaamii/site dev",
    "dev:editor": "pnpm --filter @gaaamii/editor dev",
    "dev:editor-mock-api": "pnpm --filter @gaaamii/editor mock:api",
    "build:site": "pnpm --filter @gaaamii/site build",
    "build:editor": "pnpm --filter @gaaamii/editor build",
    "preview:site": "pnpm --filter @gaaamii/site preview",
    "check:site": "pnpm --filter @gaaamii/site run check",
    "start:editor": "pnpm --filter @gaaamii/editor preview",
    "preview:editor": "pnpm --filter @gaaamii/editor preview"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
